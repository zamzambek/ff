  "segments": [
    {
      "id": "s1",
      "show": "Биринчи бөлүм. *Сүйүү*."
    },
    {
      "id": "s2",
      "show": "Сен аны биринчи жолу көргөндө, *жүрөгүң* тездеп кетет."
    },
    {
      "id": "s3",
      "show": "Колуң *тердей* баштайт. Ичиң кычышкандай болот.",
      "context": false
    },
    {
      "id": "s4",
      "show": "Бул романтика эмес. Бул — *адреналин*."
    },
    {
      "id": "s5",
      "show": "Анан мээң *дофамин* чыгарат — сыйлык гормону."
    },
    {
      "id": "s6",
      "show": "Ошондуктан телефонду *кайра-кайра* текшересиң."
    },
    {
      "id": "s7",
      "show": "Ал эми кучактаганда — *окситоцин*. Ишенимдин гормону."
    },
    {
      "id": "s8",
      "show": "Демек, сүйүү жүрөктө эмес…"
    },
    {
      "id": "s9",
      "show": "…*мээде* жашайт."
    },
    {
      "id": "s10",
      "show": "Эстеп кал: *адреналин* — толкундануу, *дофамин* — кубаныч, *окситоцин* — жакындык.",
      "context": false
    },
    {
      "id": "s11",
      "show": "Биология — бул *жашоонун* өзү."
    }
  ]
}